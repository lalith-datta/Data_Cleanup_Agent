# ============================================================
# Backend production env — for Render (Dashboard → Environment).
# Copy each KEY=value into Render; do NOT commit real secrets.
# ============================================================

# --- Database: Supabase Postgres ---------------------------------
# Supabase → Project Settings → Database → Connection string →
# "Session pooler" (IPv4, works with a long-lived SQLAlchemy pool).
# Prefix the scheme with +psycopg and require SSL.
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- CORS: allow your Vercel frontend --------------------------
# Either the exact Vercel URL, or * (safe here — the app uses no
# cookies/auth). Comma-separate multiple origins.
CORS_ORIGINS=https://your-app.vercel.app

# --- LLM (optional) --------------------------------------------
# Leave blank to run fully deterministically with the built-in
# MockLLM (no key needed — mapping still works). Set a provider to
# enable LLM adjudication of ambiguous mappings.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Storage ---------------------------------------------------
# Local ephemeral disk on the Render instance. Fine for a single
# persistent backend (upload + processing happen in one run).
UPLOAD_DIR=./uploads

# --- Agent tuning (optional; defaults are sensible) ------------
AUTO_APPLY_THRESHOLD=0.90
MIN_MAP_THRESHOLD=0.70
AMBIGUOUS_DELTA=0.08
MAX_PUSH_ATTEMPTS=3

# NOTE: Render injects $PORT automatically — do NOT set BACKEND_PORT.
